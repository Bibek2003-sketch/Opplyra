# ==============================================================================
# Opplyra — Comprehensive Git Ignore Configuration
# Protects confidential secrets, environment variables, dependencies, and build outputs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Confidential Files & Environment Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
**/*.env.*
!.env.example
!**/.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# API Keys, Private Certificates, Credentials & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
*secret*
*credential*
**/*secret*
**/*credential*
credentials.json
client_secret*.json
service-account*.json
token.json
secrets/
**/secrets/
private/
**/private/

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 3. Production Build Outputs & Caches
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.vite/
**/.vite/
.cache/
**/.cache/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Logs, Debugging & Process IDs
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock
*.seed

# ------------------------------------------------------------------------------
# 5. Database Dumps & Local Data Storage
# ------------------------------------------------------------------------------
data/
**/data/
mongo-data/
**/mongo-data/
dump/
**/dump/
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 6. Operating System & System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 7. IDE & Code Editor Configurations
# ------------------------------------------------------------------------------
.idea/
**/.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 8. Temporary, Testing & Scratch Files
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
tmp/
**/tmp/
temp/
**/temp/
scratch/
**/scratch/
.system_generated/
**/.system_generated/

frontend/node_modules/
node_modules/
