# Opplyra Backend Environment Variables
PORT=5005
MONGODB_URI=mongodb://127.0.0.1:27017/opplyra
NODE_ENV=development

# Optional SMTP Email Notifications & Deadline Reminders
# Leave blank or disabled to use built-in console logging preview (Dev/Demo mode)
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=notifications@opplyra.app
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=Opplyra Notifications <notifications@opplyra.app>
